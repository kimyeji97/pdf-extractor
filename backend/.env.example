STORAGE_BACKEND=s3

# Cloudflare R2
R2_ACCOUNT_ID=your-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=your-bucket-name
# 퍼블릭 버킷 도메인 (설정 시 presigned URL 대신 퍼블릭 URL 사용)
# 예) pub-xxxx.r2.dev  또는  files.example.com
R2_PUBLIC_DOMAIN=
# 버킷 내 루트 경로 (예: "dev", "prod"). 빈 값이면 버킷 루트에 저장
R2_ROOT_PREFIX=
