// Cloudflare Workers 정적 자산 배포 설정 (dev 프론트 = Worker `twilight-base-302d`)
// 배포: VITE_API_BASE_URL=https://dailystudy-workbook-api-dev.yejicraft-cf.com/api npm run build && npx wrangler deploy
// ⚠️ Pages가 아니다 — 2026-08-21 확인. Git 연결(Workers Builds)도 없어 push로는 배포되지 않는다.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "twilight-base-302d",
  "compatibility_date": "2026-08-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
