// Cloudflare Workers 정적 자산 배포 설정
//   dev  = 최상위 — Worker `twilight-base-302d`
//   prod = env.prod — Worker `dailystudy-workbook-prod` + 커스텀 도메인 (REQ-E02)
// 배포: ../scripts/deploy/frontend-deploy.sh dev|prod (API URL 주입 + `wrangler deploy [--env prod]`)
// ⚠️ Pages가 아니다 — 2026-08-21 확인. Git 연결(Workers Builds)도 없어 push로는 배포되지 않는다.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "twilight-base-302d",
  "compatibility_date": "2026-08-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "env": {
    "prod": {
      "name": "dailystudy-workbook-prod",
      "routes": [
        { "pattern": "dailystudy-workbook.yejicraft-cf.com", "custom_domain": true }
      ]
    }
  }
}
